# Port for Express server (Render populates PORT automatically)
PORT=5001

# Environment mode: 'development' locally, 'production' on Render
NODE_ENV=production

# MongoDB Atlas connection string
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/expiry_date_manager?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/expiry_date_manager?retryWrites=true&w=majority

# Strong random secret key for signing JWT tokens
JWT_SECRET=your_long_random_jwt_secret_key_here

# Frontend application URL for CORS configuration (Netlify URL in production)
# Multiple origins can be comma-separated: https://your-app.netlify.app,http://localhost:5173
CLIENT_URL=https://your-app-name.netlify.app
